# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-first-use/
/test-results-first-use/
/playwright-report-first-use/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing (playwright)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# generated by scripts/build-sandbox.mjs
public/sandbox/
supabase/.temp/

# RC10 design prototypes: cached artwork and API responses (third-party images, re-fetchable)
/design/rc10/.cache/

# Post-release builds and auditable local exports (never source history)
/.next-postrelease/
/.portfolio-export/
/.postrelease/
/.claude/worktrees/
# Raw masters remain local; optimized README captures are versioned.
/portfolio/assets/*.png
